#!/bin/bash
# Source-checkout bundle: launch an embedded release runtime when present, or
# guide the user to the self-contained release using macOS UI only.
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
BUNDLED="$HERE/PRII-AGUAYLUZ.bin"
RELEASES="https://github.com/jotaele44/aguayluz-pr/releases"
if [ -x "$BUNDLED" ]; then exec "$BUNDLED"; fi
CHOICE="$(osascript -e 'button returned of (display dialog "This source-checkout bundle does not contain the signed application runtime. Download the self-contained AguaYLuz disk image; it includes everything required." buttons {"Cancel", "Open Releases"} default button "Open Releases" with title "AguaYLuz")' 2>/dev/null || true)"
if [ "$CHOICE" = "Open Releases" ]; then open "$RELEASES"; fi
