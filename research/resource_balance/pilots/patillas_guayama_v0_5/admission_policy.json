{
  "schema_version": "aguayluz.patillas-t1-admission-policy/v0.5",
  "policy_id": "patillas-guayama-t1-admission-v0.5",
  "origin_main_sha": "debbef3e901c7edeb5e6d91c9dfc888383b2024c",
  "latest_main_reviewed_sha": "01a991d6b7ecaf36458d6faf1acd1012b84da897",
  "canonical_volume_unit": "m3",
  "slice_cadence_minutes": 15,
  "daily_window_slices": 96,
  "rate_interval_alignment": "exact",
  "stage_boundary_max_skew_minutes": 7.5,
  "required_evidence_tier": "T1",
  "require_provisional_false": true,
  "required_revision_status": "accepted_current",
  "required_calibration_state": "verified",
  "require_numeric_uncertainty": true,
  "require_uncertainty_source": true,
  "required_topology_state_id": "topology:patillas-guayama:20260804:v0.2",
  "require_source_sha256": true,
  "require_source_classification": "public_machine_readable_or_operator_direct",
  "proxy_only_admissible": false,
  "public_document_only_admissible_for_interval_balance": false,
  "require_stage_datum": "PRVD02",
  "stage_storage_model": "lago-patillas-stage-storage-2019-prvd02-v0.4.1",
  "stage_storage_extrapolation": "prohibited",
  "stage_storage_plateau_interpolation": "prohibited",
  "required_metrics_per_slice": [
    "rio_grande_inflow_rate",
    "rio_marin_inflow_rate",
    "reservoir_stage_start",
    "reservoir_stage_end",
    "gate_or_canal_release_rate",
    "downstream_river_release_rate",
    "direct_treatment_withdrawal_rate",
    "downstream_terminal_flow_rate",
    "area_weighted_precipitation_volume",
    "evaporation_volume",
    "documented_operational_loss_volume"
  ],
  "derived_composite_rules": {
    "upstream_inflow_rate": "rio_grande_inflow_rate + rio_marin_inflow_rate + separately_admitted_local_runoff_if_nonzero",
    "measured_reservoir_outflow_rate": "gate_or_canal_release_rate + downstream_river_release_rate"
  },
  "zero_assumption_rule": "no_required_inflow_or_outflow_component_may_be_imputed_as_zero_without_T1_evidence_for_that_interval",
  "daily_window_rule": "all_96_slices_must_be_individually_admitted_before_aggregation",
  "contradiction_rule": "reject_on_conflicting_values_for_same_metric_interval_source_or_topology",
  "missing_rule": "fail_closed",
  "asynchronous_rule": "fail_closed",
  "unknown_uncertainty_rule": "fail_closed",
  "real_execution_gate": "separate_approved_ballot_after_every_required_T1_input_is_synchronized_and_admitted",
  "activation": {
    "real_balance": false,
    "runtime": false,
    "api": false,
    "gui": false,
    "exports": false,
    "alerts": false,
    "notifications": false,
    "scheduler": false,
    "control_actions": false
  }
}
