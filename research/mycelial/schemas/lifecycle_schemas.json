{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aguayluz.local/research/mycelial/lifecycle_schemas.json",
  "$defs": {
    "site": {"type":"object","required":["site_id","name","coordinate_confidence","sensitive"],"properties":{"site_id":{"type":"string"},"name":{"type":"string"},"latitude":{"type":["number","null"]},"longitude":{"type":["number","null"]},"coordinate_confidence":{"type":"string"},"sensitive":{"type":"boolean"}}},
    "survey_session": {"type":"object","required":["survey_id","site_id","started_at","observer","method","effort_minutes","detection_status"],"properties":{"survey_id":{"type":"string"},"site_id":{"type":"string"},"started_at":{"type":"string"},"observer":{"type":"string"},"method":{"type":"string"},"effort_minutes":{"type":"number","exclusiveMinimum":0},"detection_status":{"enum":["detected","not_detected","not_assessed"]}}},
    "lifecycle_observation": {"type":"object","required":["observation_id","survey_id","site_id","observed_at","lifecycle_state","confidence"],"properties":{"observation_id":{"type":"string"},"survey_id":{"type":"string"},"site_id":{"type":"string"},"observed_at":{"type":"string"},"lifecycle_state":{"enum":["dormant_or_unknown","environmental_priming","emergence_suspected","fruiting_confirmed","expansion","peak","senescence","decomposition","post_fruiting"]},"confidence":{"enum":["low","medium","high","verified"]},"count":{"type":["integer","null"],"minimum":0},"occupied_area_m2":{"type":["number","null"],"minimum":0}}},
    "media_evidence": {"type":"object","required":["media_id","observation_id","media_type","sha256"],"properties":{"media_id":{"type":"string"},"observation_id":{"type":"string"},"media_type":{"enum":["photo","video","audio","document"]},"sha256":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"}}},
    "environmental_snapshot": {"type":"object","required":["snapshot_id","site_id","observed_at","source_id"],"properties":{"snapshot_id":{"type":"string"},"site_id":{"type":"string"},"observed_at":{"type":"string"},"source_id":{"type":"string"},"rainfall_72h_mm":{"type":["number","null"],"minimum":0},"relative_humidity_pct":{"type":["number","null"],"minimum":0,"maximum":100}}},
    "state_transition": {"type":"object","required":["transition_id","site_id","from_state","to_state","effective_at","evidence_observation_id","confidence","reason"],"properties":{"transition_id":{"type":"string"},"site_id":{"type":"string"},"from_state":{"type":"string"},"to_state":{"type":"string"},"effective_at":{"type":"string"},"evidence_observation_id":{"type":"string"},"confidence":{"enum":["low","medium","high","verified"]},"reason":{"type":"string","minLength":1}}}
  }
}
