    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.17",
    "vite": "^6.1.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^2.1.9",
    "vitest-axe": "^0.1.0"
