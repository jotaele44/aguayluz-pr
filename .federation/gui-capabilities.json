{
  "schema_version": "prii.gui-capability/v1",
  "repository": "jotaele44/aguayluz-pr",
  "policy": {
    "mode": "ratchet",
    "baseline": ".federation/gui-parity-baseline.json",
    "require_discoverable_gui": true,
    "require_e2e": true,
    "terminal_free_user_path": true
  },
  "discovery": {
    "backend_roots": [
      "server/backend"
    ],
    "production_roots": [
      "src/aguayluz",
      "desktop",
      "maintenance"
    ],
    "analysis_roots": [
      "scripts"
    ],
    "frontend_roots": [
      "dashboard/src"
    ],
    "frontend_capability_roots": [
      "dashboard/src/pages"
    ],
    "frontend_api_roots": [
      "dashboard/src/lib/api.js"
    ],
    "route_files": [
      "dashboard/src/App.jsx"
    ],
    "navigation_files": [
      "dashboard/src/components/layout/Sidebar.jsx"
    ],
    "implicit_routes": [],
    "exclude": [
      "**/tests/**",
      "**/*.test.*",
      "**/*.spec.*",
      "**/components/ui/**",
      "scripts/check_gui_parity.py"
    ]
  },
  "capabilities": [
    {
      "id": "infrastructure-assets-and-map",
      "classification": "analysis",
      "status": "active",
      "requires_terminal": false,
      "backend": {
        "files": [
          "server/backend/main.py"
        ],
        "endpoints": [
          "GET /assets",
          "GET /assets/{asset_id}/events",
          "PATCH /assets/{asset_id}",
          "GET /assets.geojson",
          "GET /municipios.geojson",
          "GET /municipios/{name}/summary"
        ]
      },
      "frontend": {
        "routes": [
          "/",
          "/map",
          "/assets",
          "/sector/:sector",
          "/municipios/:name"
        ],
        "e2e_routes": [
          "/",
          "/map",
          "/assets"
        ],
        "components": [
          "dashboard/src/lib/api.js",
          "dashboard/src/pages/OverviewPage.jsx",
          "dashboard/src/pages/MapPage.jsx",
          "dashboard/src/pages/AssetsPage.jsx",
          "dashboard/src/pages/SectorDetailPage.jsx",
          "dashboard/src/pages/MunicipioDetailPage.jsx",
          "dashboard/src/components/AssetMap.jsx",
          "dashboard/src/components/AssetsTable.jsx",
          "dashboard/src/components/AssetDetail.jsx"
        ],
        "discoverability": [
          "dashboard/src/components/layout/Sidebar.jsx",
          "dashboard/src/pages/OverviewPage.jsx"
        ]
      },
      "tests": {
        "backend": [
          "tests/test_backend_events_api.py",
          "tests/test_pr_geo_boundaries.py"
        ],
        "contract": [
          "tests/test_navigation.py",
          "tests/test_gui_parity.py"
        ],
        "e2e": [
          "dashboard/tests/gui-parity.spec.mjs"
        ]
      }
    },
    {
      "id": "alerts-outages-and-events",
      "classification": "operator",
      "status": "active",
      "requires_terminal": false,
      "backend": {
        "files": [
          "server/backend/main.py"
        ],
        "endpoints": [
          "GET /events/stream",
          "GET /events/{event_id}",
          "PATCH /events/{event_id}",
          "GET /events",
          "GET /alerts",
          "GET /alerts/facets",
          "GET /alerts.geojson",
          "GET /alerts/dependencies",
          "GET /alerts/gaps",
          "GET /alerts/{alert_id}"
        ]
      },
      "frontend": {
        "routes": [
          "/alerts",
          "/alerts/:id",
          "/outages",
          "/events/:id"
        ],
        "e2e_routes": [
          "/alerts",
          "/outages"
        ],
        "components": [
          "dashboard/src/lib/api.js",
          "dashboard/src/pages/AlertsPage.jsx",
          "dashboard/src/pages/AlertDetailPage.jsx",
          "dashboard/src/pages/OutagesPage.jsx",
          "dashboard/src/pages/EventDetailPage.jsx",
          "dashboard/src/components/OutagesPanel.jsx"
        ],
        "discoverability": [
          "dashboard/src/components/layout/Sidebar.jsx",
          "dashboard/src/pages/AlertsPage.jsx",
          "dashboard/src/components/OutagesPanel.jsx"
        ]
      },
      "tests": {
        "backend": [
          "tests/test_backend_alerts_api.py",
          "tests/test_backend_events_api.py",
          "tests/test_alerts.py"
        ],
        "contract": [
          "tests/test_gui_parity.py"
        ],
        "e2e": [
          "dashboard/tests/gui-parity.spec.mjs"
        ]
      }
    },
    {
      "id": "monitoring-analytics-and-system-state",
      "classification": "analysis",
      "status": "active",
      "requires_terminal": false,
      "backend": {
        "files": [
          "server/backend/main.py"
        ],
        "endpoints": [
          "GET /readings",
          "GET /summary",
          "GET /summary/sectors",
          "GET /summary/coverage",
          "GET /system/status"
        ]
      },
      "frontend": {
        "routes": [
          "/monitoring",
          "/analytics",
          "/logs",
          "/system"
        ],
        "e2e_routes": [
          "/monitoring",
          "/analytics",
          "/logs",
          "/system"
        ],
        "components": [
          "dashboard/src/lib/api.js",
          "dashboard/src/pages/MonitoringPage.jsx",
          "dashboard/src/pages/AnalyticsPage.jsx",
          "dashboard/src/pages/LiveLogsPage.jsx",
          "dashboard/src/pages/SystemPage.jsx",
          "dashboard/src/components/MonitoringCharts.jsx"
        ],
        "discoverability": [
          "dashboard/src/components/layout/Sidebar.jsx"
        ]
      },
      "tests": {
        "backend": [
          "tests/test_alert_impact.py",
          "tests/test_refresh_plans.py"
        ],
        "contract": [
          "tests/test_gui_parity.py"
        ],
        "e2e": [
          "dashboard/tests/gui-parity.spec.mjs"
        ]
      }
    },
    {
      "id": "review-queue",
      "classification": "operator",
      "status": "active",
      "requires_terminal": false,
      "backend": {
        "files": [
          "server/backend/main.py"
        ],
        "endpoints": [
          "GET /review-queue",
          "POST /review-queue/{ref}/decision"
        ]
      },
      "frontend": {
        "routes": [
          "/review"
        ],
        "e2e_routes": [
          "/review"
        ],
        "components": [
          "dashboard/src/lib/api.js",
          "dashboard/src/pages/ReviewPage.jsx",
          "dashboard/src/components/ReviewQueue.jsx",
          "dashboard/src/components/ReviewRecordCard.jsx"
        ],
        "discoverability": [
          "dashboard/src/components/layout/Sidebar.jsx"
        ]
      },
      "tests": {
        "backend": [
          "tests/test_backend_events_api.py"
        ],
        "contract": [
          "tests/test_gui_parity.py"
        ],
        "e2e": [
          "dashboard/tests/gui-parity.spec.mjs"
        ]
      }
    },
    {
      "id": "system-tools",
      "classification": "operator",
      "status": "active",
      "requires_terminal": false,
      "backend": {
        "files": [
          "server/backend/main.py"
        ],
        "endpoints": [
          "POST /admin/run-export",
          "POST /ai/query",
          "GET /export/report.html",
          "POST /notify"
        ]
      },
      "frontend": {
        "routes": [
          "/system"
        ],
        "e2e_routes": [
          "/system"
        ],
        "components": [
          "dashboard/src/pages/SystemPage.jsx",
          "dashboard/src/components/AiQueryPanel.jsx"
        ],
        "discoverability": [
          "dashboard/src/components/layout/Sidebar.jsx"
        ]
      },
      "tests": {
        "contract": [
          "tests/test_validate_repo.py",
          "tests/test_gui_parity.py"
        ],
        "e2e": [
          "dashboard/tests/gui-parity.spec.mjs"
        ]
      }
    },
    {
      "id": "service-health",
      "classification": "internal",
      "status": "active",
      "requires_terminal": false,
      "rationale": "Health and authentication-status probes support supervision and readiness rather than a separate user workflow.",
      "backend": {
        "files": [
          "server/backend/main.py"
        ],
        "endpoints": [
          "GET /health",
          "GET /auth/status"
        ]
      },
      "tests": {
        "backend": [
          "tests/test_server_smoke.py"
        ]
      }
    }
  ],
  "exceptions": []
}
