{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jotaele44/aguayluz-pr/schemas/infrastructure_source_assertion.schema.json",
  "title": "InfrastructureSourceAssertion",
  "description": "One raw source-row manifestation preserved independently of canonical infrastructure identity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assertion_id",
    "source_file",
    "source_sha256",
    "source_size_bytes",
    "encoding",
    "delimiter",
    "header_row_number",
    "raw_headers",
    "source_row_number",
    "raw_fields",
    "identity_effect"
  ],
  "properties": {
    "assertion_id": {"type":"string","pattern":"^AYL_SRC_[0-9a-f]{20}$"},
    "source_file": {"type":"string","minLength":1},
    "source_sha256": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "source_size_bytes": {"type":"integer","minimum":0},
    "encoding": {"type":"string","minLength":1},
    "delimiter": {"type":"string","minLength":1,"maxLength":1},
    "header_row_number": {"type":"integer","minimum":1},
    "raw_headers": {
      "type":"array",
      "minItems":1,
      "items":{"type":"string"}
    },
    "source_row_number": {"type":"integer","minimum":1},
    "raw_fields": {
      "type":"object",
      "additionalProperties":{"type":["string","null"]}
    },
    "linked_legacy_asset_id": {"type":["string","null"]},
    "linked_canonical_object_id": {"type":["string","null"]},
    "classification_decision_id": {"type":["string","null"]},
    "identity_effect": {"const":"none"},
    "notes": {"type":["string","null"]}
  }
}
