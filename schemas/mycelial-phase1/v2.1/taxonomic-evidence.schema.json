{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://aguayluz.local/schemas/mycelial-phase1/v2.1/taxonomic-evidence.schema.json","title":"Taxonomic evidence design contract","type":"object","additionalProperties":false,"required":["record_type","schema_version","assertion_id","identification_rank","asserted_name","verification_class","determiner_id","determination_date","taxonomic_authority","taxonomic_authority_version","synonym_resolution","voucher_ids","media_sha256","evidence_summary","confidence_basis"],"properties":{"record_type":{"const":"taxonomic_evidence"},"schema_version":{"const":"2.1.0"},"assertion_id":{"type":"string","pattern":"^MYC_TAX_[A-Z0-9_]{3,80}$"},"identification_rank":{"enum":["species","genus","family","guild","morphotype","unresolved"]},"asserted_name":{"type":["string","null"],"minLength":1},"verification_class":{"enum":["specimen_voucher_verified","expert_verified","media_supported","reported_unverified","unresolved_unknown"]},"determiner_id":{"type":["string","null"],"minLength":1},"determination_date":{"type":["string","null"],"format":"date"},"taxonomic_authority":{"type":"string","minLength":1},"taxonomic_authority_version":{"type":"string","minLength":1},"synonym_resolution":{"type":"object","additionalProperties":false,"required":["input_name","accepted_name","status","basis"],"properties":{"input_name":{"type":["string","null"]},"accepted_name":{"type":["string","null"]},"status":{"enum":["accepted","synonym","unresolved","not_applicable"]},"basis":{"type":"string","minLength":1}}},"voucher_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},"media_sha256":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^[0-9a-f]{64}$"}},"evidence_summary":{"type":"string","minLength":1},"confidence_basis":{"enum":["voucher","expert_determination","media_morphology","source_report_only","unresolved"]}},"allOf":[{"if":{"properties":{"verification_class":{"const":"specimen_voucher_verified"}},"required":["verification_class"]},"then":{"properties":{"voucher_ids":{"minItems":1},"determiner_id":{"type":"string","minLength":1}}}},{"if":{"properties":{"identification_rank":{"const":"unresolved"}},"required":["identification_rank"]},"then":{"properties":{"asserted_name":{"type":"null"},"verification_class":{"const":"unresolved_unknown"},"confidence_basis":{"const":"unresolved"}}}}]}
