{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://aguayluz.local/schemas/mycelial-phase1/v1/source-license-provenance.schema.json","title":"Source, license, and provenance design contracts","oneOf":[{"$ref":"#/$defs/source"},{"$ref":"#/$defs/provenance"}],"$defs":{"source":{"type":"object","additionalProperties":false,"required":["record_type","schema_version","source_id","source_title","authority","stable_source_record_id_rule","acquisition_design","license","retention","attribution","coordinate_retention_policy"],"properties":{"record_type":{"const":"source_registry_entry"},"schema_version":{"const":"1.0.0"},"source_id":{"type":"string","pattern":"^MYC_SRC_[A-Z0-9_]{3,64}$"},"source_title":{"type":"string","minLength":1},"authority":{"type":"string","minLength":1},"stable_source_record_id_rule":{"type":"string","minLength":1},"acquisition_design":{"type":"object","additionalProperties":false,"required":["method_class","locator_template","content_hash_algorithm","receipt_required"],"properties":{"method_class":{"enum":["manual_export","bounded_file_import","offline_fixture","future_provider_adapter"]},"locator_template":{"type":"string","minLength":1},"content_hash_algorithm":{"const":"sha256"},"receipt_required":{"const":true}}},"license":{"type":"object","additionalProperties":false,"required":["license_id","license_url","redistribution","derivative_use","terms_verified_at"],"properties":{"license_id":{"type":"string","minLength":1},"license_url":{"type":["string","null"],"format":"uri"},"redistribution":{"enum":["allowed","restricted","prohibited","unknown_hold"]},"derivative_use":{"enum":["allowed","restricted","prohibited","unknown_hold"]},"terms_verified_at":{"type":"string","format":"date-time"}}},"retention":{"type":"object","additionalProperties":false,"required":["raw_bytes","normalized_records","minimum_days","deletion_authority"],"properties":{"raw_bytes":{"enum":["retain","restricted_retain","do_not_retain","unknown_hold"]},"norm