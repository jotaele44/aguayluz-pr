{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aguayluz.local/schemas/failure-localization/v0.2/failure_localization_operational_adapters.schema.json",
  "title": "AguaYLuz failure-localization operational adapter contracts v0.1",
  "oneOf": [
    {"$ref": "#/$defs/operationalInput"},
    {"$ref": "#/$defs/adapterReceipt"},
    {"$ref": "#/$defs/adapterRun"}
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "ledgerMetadata": {
      "type": "object",
      "properties": {
        "recorded_at": {"type": "string", "format": "date-time"},
        "record_hash": {"$ref": "#/$defs/sha256"},
        "idempotency_key": {"type": "string", "minLength": 1},
        "payload_hash": {"$ref": "#/$defs/sha256"},
        "replayed": {"type": "boolean"}
      }
    },
    "operationalInput": {
      "type": "object",
      "required": [
        "schema_version",
        "input_id",
        "input_kind",
        "source_id",
        "observed_at",
        "received_at",
        "sha256",
        "evidence_tier",
        "freshness",
        "quality",
        "disclosure",
        "authority",
        "review_status",
        "payload"
      ],
      "properties": {
        "schema_version": {"const": "aguayluz.failure-operational-input/v0.1"},
        "input_id": {"type": "string", "minLength": 1},
        "input_kind": {
          "enum": [
            "asset_identity",
            "hydraulic_topology",
            "pressure_zone_membership",
            "flow",
            "pressure",
            "tank_level",
            "pump_state",
            "valve_state",
            "power",
            "production",
            "work_order",
            "outage",
            "restoration",
            "field_result"
          ]
        },
        "source_id": {"type": "string", "minLength": 1},
        "observed_at": {"type": "string", "format": "date-time"},
        "received_at": {"type": "string", "format": "date-time"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "evidence_tier": {"enum": ["T1", "T2", "T3", "T4"]},
        "freshness": {"enum": ["current", "stale", "future", "unknown"]},
        "quality": {"enum": ["valid", "suspect", "invalid"]},
        "disclosure": {
          "enum": [
            "public_exact",
            "public_approximate",
            "operator_restricted",
            "unresolved"
          ]
        },
        "authority": {
          "enum": [
            "operator_authoritative",
            "regulator_authoritative",
            "public_authoritative",
            "operator_declared",
            "secondary",
            "inferred",
            "synthetic_fixture"
          ]
        },
        "review_status": {"enum": ["accepted", "needs_review", "rejected"]},
        "payload": {"type": "object"}
      },
      "additionalProperties": false
    },
    "adapterReceipt": {
      "allOf": [
        {"$ref": "#/$defs/ledgerMetadata"},
        {
          "type": "object",
          "required": [
            "schema_version",
            "adapter_receipt_id",
            "bundle_id",
            "input_id",
            "input_kind",
            "source_id",
            "observed_at",
            "received_at",
            "payload_sha256",
            "as_of",
            "admission_status",
            "reason_codes",
            "append_only",
            "offline_only",
            "control_action_authorized"
          ],
          "properties": {
            "schema_version": {
              "const": "aguayluz.failure-operational-adapter-receipt/v0.1"
            },
            "adapter_receipt_id": {"type": "string", "minLength": 1},
            "bundle_id": {"type": "string", "minLength": 1},
            "input_id": {"type": "string", "minLength": 1},
            "input_kind": {"type": ["string", "null"]},
            "source_id": {"type": ["string", "null"]},
            "observed_at": {"type": ["string", "null"], "format": "date-time"},
            "received_at": {"type": ["string", "null"], "format": "date-time"},
            "payload_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
            "as_of": {"type": "string", "format": "date-time"},
            "admission_status": {
              "enum": [
                "admitted",
                "admitted_noncurrent_observation",
                "quarantined",
                "rejected"
              ]
            },
            "reason_codes": {"type": "array", "items": {"type": "string"}},
            "append_only": {"const": true},
            "offline_only": {"const": true},
            "control_action_authorized": {"const": false}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "adapterRun": {
      "allOf": [
        {"$ref": "#/$defs/ledgerMetadata"},
        {
          "type": "object",
          "required": [
            "schema_version",
            "adapter_run_id",
            "bundle_id",
            "as_of",
            "status",
            "maximum_operational_grade",
            "assessment",
            "input_count",
            "admitted_input_count",
            "observation_count",
            "receipt_ids",
            "blockers",
            "shadow_mode",
            "offline_only",
            "operator_view_read_only",
            "operator_view_enabled",
            "live_polling_enabled",
            "notifications_enabled",
            "production_promotion_enabled",
            "automatic_control_actions",
            "synthetic_fixture",
            "operational_claims_forbidden",
            "safety"
          ],
          "properties": {
            "schema_version": {
              "const": "aguayluz.failure-operational-adapter-run/v0.1"
            },
            "adapter_run_id": {"type": "string", "minLength": 1},
            "bundle_id": {"type": "string", "minLength": 1},
            "as_of": {"type": "string", "format": "date-time"},
            "status": {"enum": ["admitted", "degraded", "fail_closed"]},
            "maximum_operational_grade": {"enum": ["L0", "L1", "L2", "L3"]},
            "graph_id": {"type": ["string", "null"]},
            "assessment_id": {"type": ["string", "null"]},
            "assessment": {"type": "object"},
            "input_count": {"type": "integer", "minimum": 0},
            "admitted_input_count": {"type": "integer", "minimum": 0},
            "observation_count": {"type": "integer", "minimum": 0},
            "receipt_ids": {
              "type": "array",
              "items": {"type": "string"},
              "uniqueItems": true
            },
            "blockers": {
              "type": "array",
              "items": {"type": "string"},
              "uniqueItems": true
            },
            "shadow_mode": {"const": true},
            "offline_only": {"const": true},
            "operator_view_read_only": {"const": true},
            "operator_view_enabled": {"type": "boolean"},
            "live_polling_enabled": {"const": false},
            "notifications_enabled": {"const": false},
            "production_promotion_enabled": {"const": false},
            "automatic_control_actions": {"const": false},
            "synthetic_fixture": {"type": "boolean"},
            "operational_claims_forbidden": {"type": "boolean"},
            "safety": {"type": "object"}
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
