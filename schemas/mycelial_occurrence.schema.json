{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aguayluz.pr/schemas/mycelial_occurrence.schema.json",
  "title": "Mycelial research occurrence record",
  "type": "object",
  "additionalProperties": false,
  "required": ["occurrence_id", "source_id", "evidence_tier", "review_status", "coordinate_confidence", "taxonomic_confidence", "temporal_confidence", "sensitive", "schema_version"],
  "properties": {
    "occurrence_id": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1},
    "source_record_id": {"type": ["string", "null"]},
    "observed_at": {"type": ["string", "null"]},
    "taxon_name": {"type": ["string", "null"]},
    "latitude": {"type": ["number", "null"], "minimum": -90, "maximum": 90},
    "longitude": {"type": ["number", "null"], "minimum": -180, "maximum": 180},
    "municipality": {"type": ["string", "null"]},
    "substrate": {"type": ["string", "null"]},
    "observer": {"type": ["string", "null"]},
    "evidence_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "notes": {"type": ["string", "null"]},
    "evidence_tier": {"enum": ["T1", "T2", "T3", "T4"]},
    "review_status": {"enum": ["unreviewed", "needs_review", "accepted", "rejected"]},
    "coordinate_confidence": {"enum": ["exact", "approximate", "centroid", "unknown"]},
    "taxonomic_confidence": {"enum": ["specimen_verified", "expert_verified", "photo_supported", "reported", "unknown"]},
    "temporal_confidence": {"enum": ["exact", "day", "month", "year", "historical", "unknown"]},
    "sensitive": {"type": "boolean"},
    "schema_version": {"const": "1.0.0"}
  }
}
