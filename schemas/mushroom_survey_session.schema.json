{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://aguayluz.local/schemas/mushroom_survey_session.schema.json",
  "title":"SurveySession","type":"object","additionalProperties":false,
  "required":["survey_id","site_id","started_at","observer","method","effort_minutes","detection_status"],
  "properties":{
    "survey_id":{"type":"string","minLength":1},"site_id":{"type":"string","minLength":1},
    "started_at":{"type":"string","format":"date-time"},"ended_at":{"type":["string","null"],"format":"date-time"},
    "observer":{"type":"string","minLength":1},"method":{"type":"string","minLength":1},
    "effort_minutes":{"type":"number","exclusiveMinimum":0},"area_m2":{"type":["number","null"],"minimum":0},
    "detection_status":{"enum":["detected","not_detected","not_assessed"]},"notes":{"type":["string","null"]}
  }
}
