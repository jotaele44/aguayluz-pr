{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jotaele44/aguayluz-pr/schemas/water-asset-graph/v0.1/water_asset_graph.schema.json",
  "title": "AguaYLuz Water Asset Impact Switchboard",
  "type": "object",
  "required": [
    "schema_version",
    "baseline_id",
    "shadow_mode",
    "view_mode",
    "inventory",
    "municipio_accounting",
    "impact_counts",
    "assets",
    "relationships",
    "derived_paths",
    "timeline",
    "contradictions",
    "coverage_gaps",
    "safety"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "const": "aguayluz.water-asset-impact/v0.1"
    },
    "baseline_id": {
      "type": "string",
      "pattern": "^AYLAG_[a-f0-9]{24}$"
    },
    "shadow_mode": {
      "const": true
    },
    "public_notification_enabled": {
      "const": false
    },
    "automatic_control_actions": {
      "const": false
    },
    "view_mode": {
      "enum": [
        "public",
        "operator"
      ]
    },
    "inventory": {
      "type": "object"
    },
    "municipio_accounting": {
      "type": "object",
      "required": [
        "expected_count",
        "represented_count",
        "unresolved_asset_count",
        "missing",
        "complete"
      ],
      "properties": {
        "expected_count": {
          "type": "integer",
          "minimum": 0
        },
        "represented_count": {
          "type": "integer",
          "minimum": 0
        },
        "unresolved_asset_count": {
          "type": "integer",
          "minimum": 0
        },
        "missing": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "complete": {
          "type": "boolean"
        }
      }
    },
    "impact_counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "asset_id",
          "canonical_asset_id",
          "provenance_class",
          "identifier_quality",
          "position_uncertainty",
          "impact_status",
          "impact_confidence",
          "evidence",
          "contradictions"
        ],
        "properties": {
          "asset_id": {
            "type": "string",
            "minLength": 1
          },
          "canonical_asset_id": {
            "type": "string",
            "minLength": 1
          },
          "provenance_class": {
            "enum": [
              "public_authoritative",
              "public_secondary",
              "inferred",
              "operator_restricted",
              "unresolved"
            ]
          },
          "identifier_quality": {
            "enum": [
              "source_bound",
              "local_deterministic",
              "weak"
            ]
          },
          "position_uncertainty": {
            "enum": [
              "exact",
              "approximate",
              "unknown",
              "withheld"
            ]
          },
          "impact_status": {
            "enum": [
              "confirmed",
              "suspected",
              "derived",
              "unknown",
              "stale"
            ]
          },
          "impact_confidence": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "hop_count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 3
          },
          "evidence": {
            "type": "array"
          },
          "contradictions": {
            "type": "array"
          }
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "water_asset_relationship.schema.json"
      }
    },
    "derived_paths": {
      "type": "array"
    },
    "timeline": {
      "type": "array"
    },
    "contradictions": {
      "type": "array"
    },
    "coverage_gaps": {
      "type": "array"
    },
    "safety": {
      "type": "object",
      "required": [
        "no_fabricated_topology",
        "confidence_only_confirmation_forbidden",
        "restricted_control_detail_withheld_in_public_view"
      ]
    }
  }
}
