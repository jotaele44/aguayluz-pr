{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://federation.local/schemas/aguayluz_map_manifestation_receipt_v0_3.schema.json",
  "title": "AguaYLuz map manifestation receipt v0.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "producer_repo", "producer_commit_sha", "event_id",
    "map_manifestation_owner", "domain_authority", "geometry_authority",
    "geometry_scope", "coordinate_source", "coordinate_method",
    "coordinate_confidence", "geometry", "geometry_source_ref",
    "linked_asset_id", "inherited_geometry_release_pin", "municipality",
    "derivation_asset_ids", "canonicality", "identity_effect", "displayed",
    "spatial_state", "certification_state", "failure_reason", "receipt_id",
    "logical_sha256"
  ],
  "properties": {
    "schema_version": {"const": "aguayluz.map-manifestation-receipt.v0.3"},
    "producer_repo": {"const": "aguayluz-pr"},
    "producer_commit_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "event_id": {"type": "string", "minLength": 1},
    "map_manifestation_owner": {"const": "aguayluz-pr"},
    "domain_authority": {"const": "aguayluz-pr"},
    "geometry_authority": {"type": ["string", "null"]},
    "geometry_scope": {"type": "string"},
    "coordinate_source": {"enum": ["direct_event_coordinates", "linked_asset", "municipality_asset_average", "null_empty"]},
    "coordinate_method": {"type": "string"},
    "coordinate_confidence": {"enum": ["HIGH", "MEDIUM", "LOW", "UNKNOWN"]},
    "geometry": {"type": ["object", "null"]},
    "geometry_source_ref": {"type": ["string", "null"]},
    "linked_asset_id": {"type": ["string", "null"]},
    "inherited_geometry_release_pin": {"type": "object"},
    "municipality": {"type": ["string", "null"]},
    "derivation_asset_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "canonicality": {"enum": ["SOURCE_NATIVE_NONFEDERATION", "DERIVED_REFERENCE_LINK", "NONCANONICAL_DISPLAY_DERIVATION", "NULL_EMPTY"]},
    "identity_effect": {"const": "NONE"},
    "displayed": {"type": "boolean"},
    "spatial_state": {"enum": ["UNRESOLVED", "NULL_EMPTY"]},
    "certification_state": {"enum": ["PROVISIONAL", "OPEN", "BLOCKED", "AUDIT_ONLY"]},
    "failure_reason": {"type": ["string", "null"]},
    "receipt_id": {"type": "string", "pattern": "^maprx_[a-f0-9]{32}$"},
    "logical_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
