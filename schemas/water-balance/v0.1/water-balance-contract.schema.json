{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jotaele44/aguayluz-pr/schemas/water-balance/v0.1/water-balance-contract.schema.json",
  "title": "AguaYLuz Integrated Water Balance Contract v0.1",
  "description": "Design-only canonical definitions for Asset, FlowEdge, WaterObservation, StorageState, Withdrawal, Transfer, Release, Consumption, Loss, Uncertainty, Freshness, Quality, and Lineage.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ledger_id", "source_main_sha", "design_only", "created_at", "assets", "flow_edges", "observations", "ledger_entries"],
  "properties": {
    "schema_version": {"const": "aguayluz.water-balance/v0.1"},
    "ledger_id": {"type": "string", "pattern": "^AYL_WBC_"},
    "source_main_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "design_only": {"const": true},
    "created_at": {"type": "string", "format": "date-time"},
    "assets": {"type": "array", "items": {"$ref": "#/$defs/Asset"}},
    "flow_edges": {"type": "array", "items": {"$ref": "#/$defs/FlowEdge"}},
    "observations": {"type": "array", "items": {"$ref": "#/$defs/WaterObservation"}},
    "ledger_entries": {
      "type": "array",
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/StorageState"},
          {"$ref": "#/$defs/Withdrawal"},
          {"$ref": "#/$defs/Transfer"},
          {"$ref": "#/$defs/Release"},
          {"$ref": "#/$defs/Consumption"},
          {"$ref": "#/$defs/Loss"}
        ]
      }
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "EvidenceTier": {"enum": ["T1", "T2", "T3", "T4"]},
    "ReviewStatus": {"enum": ["accepted", "needs_review", "rejected", "blocked"]},
    "Quantity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit", "kind"],
      "properties": {
        "value": {"type": "number"},
        "unit": {"type": "string", "minLength": 1},
        "kind": {"enum": ["volume", "flow_rate", "level", "percent", "dimensionless"]},
        "normalized_value": {"type": ["number", "null"]},
        "normalized_unit": {"type": ["string", "null"]},
        "datum": {"type": ["string", "null"]}
      }
    },
    "Lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_record_ids", "source_refs", "direct_or_derived"],
      "properties": {
        "source_record_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "source_hashes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "parent_record_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "transformation_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "direct_or_derived": {"enum": ["direct", "estimated", "modeled", "derived"]},
        "source_equivalence_group": {"type": ["string", "null"]}
      }
    },
    "Uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "lower_bound", "upper_bound"],
      "properties": {
        "method": {"enum": ["instrument", "reported", "propagated", "ensemble", "expert_bounded", "unknown"]},
        "lower_bound": {"type": ["number", "null"]},
        "upper_bound": {"type": ["number", "null"]},
        "standard_deviation": {"type": ["number", "null"], "minimum": 0},
        "correlated_error_group": {"type": ["string", "null"]}
      }
    },
    "Freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed_at", "state", "eligible"],
      "properties": {
        "observed_at": {"type": "string", "format": "date-time"},
        "valid_until": {"type": ["string", "null"], "format": "date-time"},
        "state": {"enum": ["current", "stale", "historical", "future_dated", "unknown"]},
        "eligible": {"type": "boolean"},
        "exclusion_reason": {"type": ["string", "null"]}
      }
    },
    "Quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "flags", "review_status"],
      "properties": {
        "state": {"enum": ["accepted", "provisional", "needs_review", "rejected", "blocked"]},
        "flags": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["none", "missing", "stale", "contradictory", "double_counted", "meter_reset", "meter_rollover", "time_skew", "unit_error", "datum_error", "unsynchronized", "provisional", "outlier", "interpolated", "modeled", "restricted"]}
        },
        "review_status": {"$ref": "#/$defs/ReviewStatus"}
      }
    },
    "Asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "asset_type", "name", "source_asset_ids", "topology_state", "balance_boundary_eligible", "evidence_tier", "review_status"],
      "properties": {
        "asset_id": {"type": "string", "pattern": "^AYL_WBA_"},
        "asset_type": {"enum": ["watershed", "reservoir", "lake", "river", "stream", "canal", "aquifer", "well", "intake", "treatment_plant", "pump_station", "tank", "main", "valve", "interconnection", "pressure_zone", "service_area", "outfall", "consumer_group", "environmental_sink", "unknown"]},
        "name": {"type": "string", "minLength": 1},
        "source_asset_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "aliases": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "operator": {"type": ["string", "null"]},
        "municipality": {"type": ["string", "null"]},
        "disclosure_class": {"enum": ["public_exact", "public_generalized", "operator_restricted", "unknown"]},
        "topology_state": {"enum": ["authoritative", "declared", "inferred", "unresolved", "restricted"]},
        "balance_boundary_eligible": {"type": "boolean"},
        "evidence_tier": {"$ref": "#/$defs/EvidenceTier"},
        "review_status": {"$ref": "#/$defs/ReviewStatus"}
      }
    },
    "FlowEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edge_id", "from_asset_id", "to_asset_id", "edge_type", "topology_state", "balance_eligible", "lineage", "evidence_tier", "review_status"],
      "properties": {
        "edge_id": {"type": "string", "pattern": "^AYL_WBE_"},
        "from_asset_id": {"type": "string", "pattern": "^AYL_WBA_"},
        "to_asset_id": {"type": "string", "pattern": "^AYL_WBA_"},
        "edge_type": {"enum": ["inflow", "outflow", "withdrawal", "transfer", "release", "recharge", "seepage", "evaporation", "return_flow", "treatment_production", "distribution", "consumption", "loss", "contextual_dependency", "unknown"]},
        "topology_state": {"enum": ["authoritative", "declared", "inferred", "unresolved", "restricted"]},
        "balance_eligible": {"type": "boolean"},
        "eligibility_reasons": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "lineage": {"$ref": "#/$defs/Lineage"},
        "evidence_tier": {"$ref": "#/$defs/EvidenceTier"},
        "review_status": {"$ref": "#/$defs/ReviewStatus"}
      }
    },
    "WaterObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observation_id", "phenomenon", "quantity", "interval_start", "interval_end", "temporal_precision", "uncertainty", "freshness", "quality", "lineage", "balance_eligible"],
      "properties": {
        "observation_id": {"type": "string", "pattern": "^AYL_WBO_"},
        "asset_id": {"type": ["string", "null"]},
        "edge_id": {"type": ["string", "null"]},
        "phenomenon": {"enum": ["precipitation", "stage", "storage_volume", "storage_percent", "flow_rate", "cumulative_volume", "withdrawal_volume", "transfer_volume", "release_volume", "consumption_volume", "loss_volume", "groundwater_level", "pressure", "tank_level", "evaporation", "evapotranspiration", "recharge", "water_quality", "energy_state", "gate_position", "pump_state", "meter_state", "other"]},
        "quantity": {"$ref": "#/$defs/Quantity"},
        "interval_start": {"type": "string", "format": "date-time"},
        "interval_end": {"type": "string", "format": "date-time"},
        "temporal_precision": {"enum": ["instant", "hour", "day", "month", "unknown"]},
        "uncertainty": {"$ref": "#/$defs/Uncertainty"},
        "freshness": {"$ref": "#/$defs/Freshness"},
        "quality": {"$ref": "#/$defs/Quality"},
        "lineage": {"$ref": "#/$defs/Lineage"},
        "balance_eligible": {"type": "boolean"},
        "eligibility_reasons": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      },
      "anyOf": [
        {"required": ["asset_id"], "properties": {"asset_id": {"type": "string"}}},
        {"required": ["edge_id"], "properties": {"edge_id": {"type": "string"}}}
      ]
    },
    "EntryCommon": {
      "type": "object",
      "required": ["entry_id", "boundary_asset_id", "interval_start", "interval_end", "quantity", "observation_ids", "uncertainty", "freshness", "quality", "lineage", "balance_eligible"],
      "properties": {
        "entry_id": {"type": "string", "pattern": "^AYL_WBL_"},
        "boundary_asset_id": {"type": "string", "pattern": "^AYL_WBA_"},
        "interval_start": {"type": "string", "format": "date-time"},
        "interval_end": {"type": "string", "format": "date-time"},
        "quantity": {"$ref": "#/$defs/Quantity"},
        "observation_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^AYL_WBO_"}},
        "uncertainty": {"$ref": "#/$defs/Uncertainty"},
        "freshness": {"$ref": "#/$defs/Freshness"},
        "quality": {"$ref": "#/$defs/Quality"},
        "lineage": {"$ref": "#/$defs/Lineage"},
        "balance_eligible": {"type": "boolean"},
        "eligibility_reasons": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "StorageState": {
      "allOf": [
        {"$ref": "#/$defs/EntryCommon"},
        {"type": "object", "required": ["entry_type", "storage_asset_id", "state_role"], "properties": {"entry_type": {"const": "storage_state"}, "storage_asset_id": {"type": "string", "pattern": "^AYL_WBA_"}, "state_role": {"enum": ["opening", "closing", "change"]}}}
      ]
    },
    "Withdrawal": {
      "allOf": [
        {"$ref": "#/$defs/EntryCommon"},
        {"type": "object", "required": ["entry_type", "from_asset_id", "to_asset_id"], "properties": {"entry_type": {"const": "withdrawal"}, "from_asset_id": {"type": "string"}, "to_asset_id": {"type": "string"}}}
      ]
    },
    "Transfer": {
      "allOf": [
        {"$ref": "#/$defs/EntryCommon"},
        {"type": "object", "required": ["entry_type", "from_asset_id", "to_asset_id"], "properties": {"entry_type": {"const": "transfer"}, "from_asset_id": {"type": "string"}, "to_asset_id": {"type": "string"}}}
      ]
    },
    "Release": {
      "allOf": [
        {"$ref": "#/$defs/EntryCommon"},
        {"type": "object", "required": ["entry_type", "from_asset_id", "to_asset_id", "release_class"], "properties": {"entry_type": {"const": "release"}, "from_asset_id": {"type": "string"}, "to_asset_id": {"type": "string"}, "release_class": {"enum": ["controlled", "spill", "environmental", "bypass", "backwash", "sludge_water", "unknown"]}}}
      ]
    },
    "Consumption": {
      "allOf": [
        {"$ref": "#/$defs/EntryCommon"},
        {"type": "object", "required": ["entry_type", "from_asset_id", "to_asset_id", "consumption_class"], "properties": {"entry_type": {"const": "consumption"}, "from_asset_id": {"type": "string"}, "to_asset_id": {"type": "string"}, "consumption_class": {"enum": ["metered", "authorized_unbilled", "process_use", "estimated", "unknown"]}}}
      ]
    },
    "Loss": {
      "allOf": [
        {"$ref": "#/$defs/EntryCommon"},
        {"type": "object", "required": ["entry_type", "from_asset_id", "to_asset_id", "loss_class", "proof_state"], "properties": {"entry_type": {"const": "loss"}, "from_asset_id": {"type": "string"}, "to_asset_id": {"type": "string"}, "loss_class": {"enum": ["measured_physical", "authorized_unbilled", "apparent_metering", "model_residual", "unresolved"]}, "proof_state": {"enum": ["measured", "corroborated_candidate", "model_only", "not_proven"]}, "candidate_causes": {"type": "array", "uniqueItems": true, "items": {"enum": ["meter_error", "time_alignment", "unit_or_datum_error", "storage_curve_error", "missing_operational_record", "hydrologic_model_gap", "authorized_unmetered_use", "apparent_loss", "physical_leak", "unrecorded_abstraction", "unknown"]}}}}
      ]
    }
  }
}
