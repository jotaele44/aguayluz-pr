{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prii.local/schemas/water-disruption/v0.1/aguayluz-water-incident.schema.json",
  "title": "Agua y Luz canonical water service incident",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "incident_id", "incident_dedup_key", "truth_state", "lifecycle_state", "candidate_ids", "evidence_ids", "validation", "location", "service_effect", "created_at", "updated_at", "lifecycle_events"],
  "properties": {
    "schema_version": {"const": "prii.water-disruption/v0.1"},
    "incident_id": {"type": "string", "pattern": "^AYL-WI-[a-f0-9]{24}$"},
    "incident_dedup_key": {"type": "string", "minLength": 16},
    "truth_state": {"enum": ["unverified", "corroborated", "confirmed", "disputed", "retracted"]},
    "lifecycle_state": {"enum": ["reported", "acknowledged", "confirmed", "repair_planned", "repair_in_progress", "partial_restoration", "restored", "closed", "cancelled"]},
    "candidate_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "validation": {"$ref": "#/$defs/validation"},
    "location": {"$ref": "#/$defs/location"},
    "infrastructure_asset_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "service_effect": {"enum": ["outage", "low_pressure", "intermittent", "quality_advisory", "possible_disruption", "restored", "unknown"]},
    "cause_family": {"enum": ["broken_main", "broken_tubing", "leak", "repair", "valve_work", "pump_failure", "well_failure", "tank_failure", "treatment_failure", "planned_work", "quality_event", "unknown"]},
    "affected_areas_text": {"type": "array", "items": {"type": "string"}},
    "estimated_customers": {"type": ["integer", "null"], "minimum": 0},
    "impact_geometry": {"type": ["object", "null"]},
    "impact_geometry_method": {"type": ["string", "null"]},
    "started_at": {"type": ["string", "null"], "format": "date-time"},
    "expected_restoration_at": {"type": ["string", "null"], "format": "date-time"},
    "restored_at": {"type": ["string", "null"], "format": "date-time"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "lifecycle_events": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/lifecycle_event"}}
  },
  "$defs": {
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "policy_version", "decided_at", "basis", "authoritative_support", "independent_source_count", "reviewer_approved"],
      "properties": {
        "decision": {"enum": ["accepted_unverified", "needs_review", "rejected", "corroborated", "confirmed"]},
        "policy_version": {"type": "string"},
        "decided_at": {"type": "string", "format": "date-time"},
        "decided_by": {"type": ["string", "null"]},
        "basis": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "authoritative_support": {"type": "boolean"},
        "independent_source_count": {"type": "integer", "minimum": 0},
        "reviewer_approved": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {"properties": {"decision": {"const": "confirmed"}}},
          "then": {
            "anyOf": [
              {"properties": {"authoritative_support": {"const": true}}},
              {"properties": {"independent_source_count": {"minimum": 2}, "reviewer_approved": {"const": true}}}
            ]
          }
        }
      ]
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["municipality", "resolution_status"],
      "properties": {
        "municipality": {"type": ["string", "null"]},
        "barrio": {"type": ["string", "null"]},
        "sector": {"type": ["string", "null"]},
        "road": {"type": ["string", "null"]},
        "latitude": {"type": ["number", "null"]},
        "longitude": {"type": ["number", "null"]},
        "resolution_status": {"enum": ["exact", "approximate", "municipality_only", "unresolved"]}
      }
    },
    "lifecycle_event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "from_state", "to_state", "occurred_at", "evidence_ids", "policy_version", "append_only"],
      "properties": {
        "event_id": {"type": "string"},
        "from_state": {"type": ["string", "null"]},
        "to_state": {"type": "string"},
        "occurred_at": {"type": "string", "format": "date-time"},
        "actor": {"type": ["string", "null"]},
        "evidence_ids": {"type": "array", "items": {"type": "string"}},
        "policy_version": {"type": "string"},
        "reason": {"type": "string"},
        "append_only": {"const": true}
      }
    }
  }
}
