{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jotaele44/aguayluz-pr/schemas/laguna-cartagena/v0.2/laguna_cartagena_coverage.schema.json",
  "title": "Laguna Cartagena monitoring coverage ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "target",
    "synchronization_policy",
    "required_current_metrics",
    "coverage",
    "preserve"
  ],
  "properties": {
    "schema_version": {
      "const": "aguayluz.laguna-cartagena-monitoring-coverage/v0.2"
    },
    "target": {
      "type": "object",
      "required": [
        "target_id",
        "name",
        "municipalities",
        "condition_status",
        "shadow_mode"
      ]
    },
    "synchronization_policy": {
      "type": "object",
      "required": [
        "max_skew_hours",
        "balance_tolerance_fraction",
        "required_balance_metrics",
        "optional_balance_metrics"
      ]
    },
    "required_current_metrics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "coverage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "coverage_id",
          "provider",
          "source_type",
          "location_ids",
          "name",
          "role",
          "direct_or_proxy",
          "hydrologic_representativeness",
          "historical_baseline",
          "current_public_series",
          "current_condition_eligible",
          "metrics",
          "gap"
        ],
        "properties": {
          "coverage_id": {
            "type": "string",
            "pattern": "^LC-COV-"
          },
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "source_type": {
            "type": "string",
            "minLength": 1
          },
          "location_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "direct_or_proxy": {
            "enum": [
              "direct",
              "proxy",
              "context"
            ]
          },
          "hydrologic_representativeness": {
            "enum": [
              "direct",
              "high",
              "medium",
              "low",
              "none"
            ]
          },
          "historical_baseline": {
            "type": "boolean"
          },
          "current_public_series": {
            "type": "boolean"
          },
          "current_condition_eligible": {
            "const": false
          },
          "metrics": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "gap": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "preserve": {
      "type": "object"
    }
  }
}
