{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jotaele44/aguayluz-pr/schemas/alert_event.schema.json",
  "title": "AlertEvent",
  "description": "Operational alert event in the AguaYLuz-PR multi-sector alert system.",
  "type": "object",
  "required": ["alert_id", "module_id", "event_type", "status", "source_title", "source_ref", "start_at", "asset_name", "municipalities", "coord_confidence", "severity", "confidence", "gap_status", "review_status", "evidence_tier"],
  "additionalProperties": false,
  "properties": {
    "alert_id": {"type": "string", "pattern": "^AYL_ALR_[0-9]{8}_[A-Za-z0-9_-]+$"},
    "module_id": {"enum": ["HYDRO_OPS", "POWER_OPS", "WEATHER_HAZARD", "CONTAMINATION", "TRANSPORT_ACCESS", "TELECOM_SCADA", "DAM_SAFETY", "SEISMIC_GEO", "INDUSTRIAL", "PUBLIC_NOTICE", "CAVE_KARST"]},
    "event_type": {"enum": ["maintenance", "outage", "failure", "quality", "hazard", "inspection", "unknown"]},
    "status": {"enum": ["draft", "validated", "active", "closed", "rejected"]},
    "source_title": {"type": "string", "minLength": 1},
    "source_ref": {"type": "string", "minLength": 1},
    "source_hash": {"type": ["string", "null"]},
    "published_at": {"type": ["string", "null"], "format": "date-time"},
    "start_at": {"type": "string", "format": "date-time"},
    "end_at": {"type": ["string", "null"], "format": "date-time"},
    "estimated_duration_hr": {"type": ["number", "null"], "minimum": 0},
    "asset_name": {"type": "string", "minLength": 1},
    "asset_id": {"type": ["string", "null"], "description": "Foreign key to a canonical AguaYLuz asset. Cave/karst IDs are permitted."},
    "operator": {"type": ["string", "null"]},
    "municipalities": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "sectors_impacted": {"type": "array", "items": {"type": "string"}, "default": []},
    "latitude": {"type": ["number", "null"], "minimum": 17.7, "maximum": 18.7},
    "longitude": {"type": ["number", "null"], "minimum": -67.95, "maximum": -65.2},
    "coord_confidence": {"enum": ["exact", "approximate", "unknown"]},
    "severity": {"type": "integer", "minimum": 0, "maximum": 5},
    "confidence": {"type": "integer", "minimum": 0, "maximum": 100},
    "ilap_score": {"type": ["integer", "null"], "minimum": 0, "maximum": 5},
    "covert_flags": {"type": "array", "items": {"type": "string"}, "default": []},
    "gap_status": {"enum": ["none", "minor", "major", "blocking"]},
    "review_status": {"enum": ["accepted", "needs_review", "rejected", "blocked"]},
    "evidence_tier": {"enum": ["T1", "T2", "T3", "T4"]},
    "linked_asset_ids": {"type": "array", "items": {"type": "string"}, "default": []},
    "validation_notes": {"type": ["string", "null"]}
  }
}
