{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jotaele44/aguayluz-pr/schemas/drought-resilience/v0.1/water_supply_system.schema.json",
  "title": "WaterSupplySystem",
  "description": "Declared water-supply topology. Every edge requires an evidence binding; proximity, same municipality, names, and count equality are insufficient to prove physical flow.",
  "type": "object",
  "additionalProperties": false,
  "required": ["system_id", "name", "as_of", "source_ref", "review_status", "nodes", "edges"],
  "properties": {
    "system_id": {"type": "string", "pattern": "^AYL_WSS_[A-Za-z0-9_.-]+$"},
    "name": {"type": "string", "minLength": 1},
    "as_of": {"type": "string", "format": "date"},
    "source_ref": {"type": "string", "minLength": 1},
    "review_status": {"enum": ["accepted", "needs_review", "rejected", "blocked"]},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node_id", "node_type", "name"],
        "properties": {
          "node_id": {"type": "string", "minLength": 1},
          "node_type": {"enum": ["source", "intake", "well", "treatment", "storage", "distribution", "demand"]},
          "name": {"type": "string", "minLength": 1},
          "asset_id": {"type": ["string", "null"]},
          "source_kind": {"enum": ["reservoir", "surface_water", "groundwater", "spring", "transfer", "desalination", "rainwater", "other", "not_applicable"]},
          "municipality": {"type": ["string", "null"]}
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["edge_id", "from_node_id", "to_node_id", "binding_ref", "binding_type"],
        "properties": {
          "edge_id": {"type": "string", "minLength": 1},
          "from_node_id": {"type": "string", "minLength": 1},
          "to_node_id": {"type": "string", "minLength": 1},
          "binding_ref": {"type": "string", "minLength": 1},
          "binding_type": {"enum": ["stable_id", "authoritative_record", "operator_document", "certified_geometry", "historical_continuity_corroborated", "unresolved"]},
          "confidence": {"type": ["integer", "null"], "minimum": 0, "maximum": 100}
        }
      }
    }
  }
}
