{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AguaYLuz Environmental Observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["observation_id", "source_record_id", "entity_ids", "medium", "analyte_raw", "result_raw", "sample_date", "evidence_tier", "review_status"],
  "properties": {
    "observation_id": {"type": "string", "minLength": 1},
    "source_record_id": {"type": "string", "minLength": 1},
    "entity_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "medium": {"enum": ["GROUNDWATER", "SURFACE_WATER", "SEDIMENT", "SOIL", "AIR", "OTHER", "UNKNOWN"]},
    "matrix": {"type": ["string", "null"]},
    "analyte_raw": {"type": "string"},
    "analyte_normalized": {"type": ["string", "null"]},
    "analyte_canonical": {"type": ["string", "null"]},
    "cas_number": {"type": ["string", "null"]},
    "result_raw": {"type": "string"},
    "result_value": {"type": ["number", "null"]},
    "result_unit": {"type": ["string", "null"]},
    "qualifier": {"type": ["string", "null"]},
    "detection_limit": {"type": ["number", "null"]},
    "reporting_limit": {"type": ["number", "null"]},
    "sample_date": {"type": ["string", "null"]},
    "sample_time": {"type": ["string", "null"]},
    "method": {"type": ["string", "null"]},
    "evidence_tier": {"enum": ["T1", "T2", "T3", "T4"]},
    "review_status": {"enum": ["accepted", "needs_review", "rejected", "blocked", "unresolved"]}
  }
}
