{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://aguayluz.local/schemas/mushroom_media_evidence.schema.json",
  "title":"MediaEvidence","type":"object","additionalProperties":false,
  "required":["media_id","observation_id","media_type","sha256"],
  "properties":{
    "media_id":{"type":"string","minLength":1},"observation_id":{"type":"string","minLength":1},
    "media_type":{"enum":["photo","video","audio","document"]},"sha256":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"},
    "captured_at":{"type":["string","null"],"format":"date-time"},"source_uri":{"type":["string","null"]},"caption":{"type":["string","null"]}
  }
}
