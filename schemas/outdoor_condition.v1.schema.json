{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jotaele44/aguayluz-pr/schemas/outdoor_condition.v1.schema.json",
  "title": "AguaYLuz Outdoor Condition v1",
  "description": "One municipio's current outdoor conditions, composed by aguayluz.outdoor.compose from public sources. Every component carries an explicit state; a component without data says why and is never presented as benign. Conditions are context, not safety advice.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "condition_id", "geoid", "municipio", "lat", "lon",
    "geometry_precision", "coastal", "composed_at", "as_of", "summary", "components", "scope_note"
  ],
  "properties": {
    "schema_version": {"const": "aguayluz.outdoor-condition/v1"},
    "condition_id": {"type": "string", "pattern": "^AYL_OUTDOOR_72[0-9]{3}$"},
    "geoid": {"type": "string", "pattern": "^72[0-9]{3}$"},
    "municipio": {"type": "string", "minLength": 1},
    "lat": {"type": "number", "minimum": 17.8, "maximum": 18.6},
    "lon": {"type": "number", "minimum": -68.0, "maximum": -65.2},
    "geometry_precision": {"const": "REPRESENTATIVE_POINT"},
    "coastal": {"type": "boolean"},
    "composed_at": {"type": "string", "format": "date-time"},
    "as_of": {"type": ["string", "null"], "format": "date-time"},
    "scope_note": {"type": "string", "minLength": 1},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "drivers", "components_with_data", "stale_components", "unavailable_components"],
      "properties": {
        "level": {"enum": ["ELEVATED", "CAUTION", "NO_DRIVER_REPORTED", "INSUFFICIENT_DATA"]},
        "drivers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["component", "level", "reason"],
            "properties": {
              "component": {"$ref": "#/$defs/component_name"},
              "level": {"enum": ["ELEVATED", "CAUTION"]},
              "reason": {"type": "string", "minLength": 1}
            }
          }
        },
        "components_with_data": {"type": "array", "items": {"$ref": "#/$defs/component_name"}},
        "stale_components": {"type": "array", "items": {"$ref": "#/$defs/component_name"}},
        "unavailable_components": {"type": "array", "items": {"$ref": "#/$defs/component_name"}}
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rip_current", "marine_alerts", "sea_state", "beach_water_quality", "uv", "heat",
        "air_quality", "rainfall_24h", "river_flood", "nws_alerts", "tropical_cyclone",
        "earthquakes", "access_closures"
      ],
      "properties": {
        "rip_current": {"$ref": "#/$defs/component"},
        "marine_alerts": {"$ref": "#/$defs/component"},
        "sea_state": {"$ref": "#/$defs/component"},
        "beach_water_quality": {"$ref": "#/$defs/component"},
        "uv": {"$ref": "#/$defs/component"},
        "heat": {"$ref": "#/$defs/component"},
        "air_quality": {"$ref": "#/$defs/component"},
        "rainfall_24h": {"$ref": "#/$defs/component"},
        "river_flood": {"$ref": "#/$defs/component"},
        "nws_alerts": {"$ref": "#/$defs/component"},
        "tropical_cyclone": {"$ref": "#/$defs/component"},
        "earthquakes": {"$ref": "#/$defs/component"},
        "access_closures": {"$ref": "#/$defs/component"}
      }
    }
  },
  "$defs": {
    "component_name": {
      "enum": [
        "rip_current", "marine_alerts", "sea_state", "beach_water_quality", "uv", "heat",
        "air_quality", "rainfall_24h", "river_flood", "nws_alerts", "tropical_cyclone",
        "earthquakes", "access_closures"
      ]
    },
    "component": {
      "type": "object",
      "required": ["state", "source_ids"],
      "properties": {
        "state": {
          "enum": ["REPORTED", "NONE_ACTIVE", "STALE", "NOT_COVERED", "NOT_INGESTED", "NOT_CONFIGURED", "SOURCE_FAILED"]
        },
        "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "evidence_class": {
          "enum": [
            "STABLE_ID", "AUTHORITATIVE_BINDING", "CERTIFIED_GEOMETRY", "POINT_IN_POLYGON_WITH_ALIAS",
            "POINT_IN_POLYGON", "ALIAS_WITH_SPATIOTEMPORAL_SUPPORT", "HISTORICAL_CONTINUITY",
            "PROXIMITY", "DISCOVERY_ONLY", "UNRESOLVED", null
          ]
        },
        "carried_forward": {"type": "boolean"},
        "carried_from": {"type": ["string", "null"]},
        "source_status": {"enum": ["FRESH", "STALE", "FAILED", "NEVER"]},
        "note": {"type": ["string", "null"]}
      }
    }
  }
}
