{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jotaele44/aguayluz-pr/schemas/cave_karst_source.schema.json",
  "title": "CaveKarstSource",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_id",
    "title",
    "publisher",
    "source_type",
    "url",
    "retrieved_at",
    "evidence_tier",
    "content_hash",
    "review_status"
  ],
  "properties": {
    "source_id": {
      "type": "string",
      "pattern": "^SRC_KARST_[A-Z0-9_]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "source_type": {
      "enum": [
        "agency_notice",
        "official_destination_page",
        "procurement_notice",
        "monitoring_feed",
        "field_observation",
        "secondary_report",
        "other"
      ]
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "published_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_tier": {
      "enum": [
        "T1",
        "T2",
        "T3",
        "T4"
      ]
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "review_status": {
      "enum": [
        "accepted",
        "needs_review",
        "rejected",
        "blocked"
      ]
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
