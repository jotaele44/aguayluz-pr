{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jotaele44/aguayluz-pr/schemas/regulatory_source_receipt.schema.json",
  "title": "RegulatorySourceReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_id",
    "provider",
    "retrieved_at",
    "request_locator",
    "sha256",
    "byte_count",
    "media_type",
    "retrieval_status"
  ],
  "properties": {
    "receipt_id": {"type": "string", "pattern": "^AYL_REGRCPT_[A-Za-z0-9._:-]+$"},
    "provider": {"enum": ["EPA", "FDA", "USGS", "DRNA", "PRASA_AAA", "PREQB"]},
    "retrieved_at": {"type": "string", "format": "date-time"},
    "request_locator": {"type": "string", "minLength": 1},
    "http_status": {"type": ["integer", "null"], "minimum": 100, "maximum": 599},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "byte_count": {"type": "integer", "minimum": 0},
    "media_type": {"type": "string", "minLength": 1},
    "etag": {"type": ["string", "null"]},
    "last_modified": {"type": ["string", "null"]},
    "retrieval_status": {"enum": ["success", "not_modified", "not_found", "rate_limited", "failed", "rejected"]},
    "checkpoint_id": {"type": ["string", "null"]},
    "redactions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "error_class": {"type": ["string", "null"]},
    "error_message": {"type": ["string", "null"]}
  }
}
