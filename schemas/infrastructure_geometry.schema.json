{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jotaele44/aguayluz-pr/schemas/infrastructure_geometry.schema.json",
  "title": "InfrastructureGeometryManifestation",
  "description": "Versioned geometry manifestation for an infrastructure object. Geometry provenance and derivation are distinct from object identity.",
  "type": "object",
  "additionalProperties": false,
  "required": ["geometry_id", "object_id", "geometry_type", "crs", "derivation_method", "source_assertion_ids", "identity_effect", "certification_state"],
  "properties": {
    "geometry_id": {"type": "string", "pattern": "^AYL_GEO_[A-Z0-9_]+$"},
    "object_id": {"type": "string", "minLength": 1},
    "geometry_type": {"enum": ["Point", "MultiPoint", "LineString", "MultiLineString", "Polygon", "MultiPolygon", "GeometryCollection"]},
    "geometry": {"type": ["object", "null"]},
    "geometry_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "crs": {"type": "string", "minLength": 1},
    "z_state": {"enum": ["present", "absent", "unknown"]},
    "m_state": {"enum": ["present", "absent", "unknown"]},
    "valid_from": {"type": ["string", "null"], "format": "date-time"},
    "valid_to": {"type": ["string", "null"], "format": "date-time"},
    "derivation_method": {"enum": ["source_native", "centroid_derived", "interior_point_derived", "geocoded", "digitized", "crosswalked", "inferred", "unknown"]},
    "precision_m": {"type": ["number", "null"], "minimum": 0},
    "source_assertion_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "identity_effect": {"const": "none"},
    "spatial_state": {"enum": ["FULLY_WITHIN", "PARTIAL", "TOUCH_ONLY", "OUTSIDE", "NULL_EMPTY", "UNRESOLVED"]},
    "certification_state": {"enum": ["PASS", "FAIL", "OPEN", "BLOCKED", "PROVISIONAL", "AUDIT_ONLY", "NONCANONICAL", "CANDIDATE_NOT_IDENTITY", "UNRESOLVED", "SUPERSEDED"]},
    "notes": {"type": ["string", "null"]}
  },
  "allOf": [
    {
      "if": {"properties": {"derivation_method": {"const": "source_native"}}},
      "then": {"properties": {"precision_m": {"type": ["number", "null"], "minimum": 0}}}
    }
  ]
}
