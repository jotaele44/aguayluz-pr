{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AguaYLuz Environmental Entity",
  "type": "object",
  "additionalProperties": false,
  "required": ["entity_id", "entity_kind", "name_raw", "authority", "authority_id", "valid_from", "valid_until", "source_record_ids", "review_status"],
  "properties": {
    "entity_id": {"type": "string", "minLength": 1},
    "entity_kind": {"type": "string", "minLength": 1},
    "name_raw": {"type": "string"},
    "name_normalized": {"type": ["string", "null"]},
    "canonical_name": {"type": ["string", "null"]},
    "authority": {"type": "string", "minLength": 1},
    "authority_id": {"type": "string", "minLength": 1},
    "utility_asset_id": {"type": ["string", "null"]},
    "municipality": {"type": ["string", "null"]},
    "valid_from": {"type": ["string", "null"]},
    "valid_until": {"type": ["string", "null"]},
    "source_record_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "review_status": {"enum": ["accepted", "needs_review", "rejected", "blocked", "unresolved"]}
  }
}
