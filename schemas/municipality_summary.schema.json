{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jotaele44/aguayluz-pr/schemas/municipality_summary.schema.json",
  "title": "MunicipalitySummaries",
  "description": "Per-PR-municipality infrastructure dossier aggregated from utility_assets + service_events + reconciliation findings + watershed delineations. Drives the federation hub's geographic dashboard and a printable operational brief. Records without a recognizable municipality flow to a single `unattributed` bucket.",
  "type": "object",
  "required": ["module_id", "generated_at", "municipalities", "unattributed"],
  "additionalProperties": false,
  "properties": {
    "module_id":   { "const": "aguayluz-pr" },
    "generated_at": { "type": "string", "format": "date-time" },
    "municipalities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "municipality",
          "asset_counts",
          "asset_status_mix",
          "watershed_area_sqkm_total",
          "service_events_total",
          "active_events",
          "contradictions_summary",
          "partial_coverage_count",
          "top_findings"
        ],
        "additionalProperties": false,
        "properties": {
          "municipality": { "type": "string", "minLength": 1 },
          "asset_counts": {
            "type": "object",
            "required": ["by_type", "total"],
            "additionalProperties": false,
            "properties": {
              "by_type": {
                "type": "object",
                "additionalProperties": { "type": "integer", "minimum": 0 }
              },
              "total": { "type": "integer", "minimum": 0 }
            }
          },
          "asset_status_mix": {
            "type": "object",
            "additionalProperties": { "type": "integer", "minimum": 0 }
          },
          "watershed_area_sqkm_total": { "type": "number", "minimum": 0 },
          "service_events_total":       { "type": "integer", "minimum": 0 },
          "active_events":              { "type": "integer", "minimum": 0 },
          "contradictions_summary": {
            "type": "object",
            "required": ["warn", "critical"],
            "additionalProperties": false,
            "properties": {
              "warn":     { "type": "integer", "minimum": 0 },
              "critical": { "type": "integer", "minimum": 0 }
            }
          },
          "partial_coverage_count": { "type": "integer", "minimum": 0 },
          "top_findings": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["kind", "details"],
              "additionalProperties": false,
              "properties": {
                "kind":     { "type": "string", "minLength": 1 },
                "details":  { "type": "string", "minLength": 1 },
                "severity": { "enum": ["info", "warn", "critical"] }
              }
            }
          }
        }
      }
    },
    "unattributed": {
      "type": "object",
      "required": ["asset_total", "event_total"],
      "additionalProperties": false,
      "properties": {
        "asset_total": { "type": "integer", "minimum": 0 },
        "event_total": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
