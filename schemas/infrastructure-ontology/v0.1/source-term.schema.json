{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aguayluz.local/schemas/infrastructure-ontology/v0.1/source-term.schema.json",
  "title": "AguaYLuz Source Term v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","source_term_id","literal","language","source_authority","source_context","source_ref","observed_form_preserved"],
  "properties": {
    "schema_version": {"const": "aguayluz.infrastructure-ontology-source-term/v0.1"},
    "source_term_id": {"type": "string", "minLength": 1},
    "literal": {"type": "string", "minLength": 1},
    "language": {"enum": ["es","en","mixed","und"]},
    "source_authority": {"type": "string", "minLength": 1},
    "source_context": {"type": "string", "minLength": 1},
    "source_ref": {"type": "string", "minLength": 1},
    "observed_form_preserved": {"const": true},
    "first_seen_at": {"type": ["string","null"], "format": "date-time"},
    "notes": {"type": ["string","null"]}
  }
}