{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://aguayluz.local/schemas/infrastructure-ontology/v0.1/deprecation.schema.json",
  "title":"AguaYLuz Ontology Deprecation v0.1",
  "type":"object","additionalProperties":false,
  "required":["schema_version","deprecation_id","deprecated_identifier","replacement_identifiers","effective_version","reason","queryable","raw_records_rewritten"],
  "properties":{
    "schema_version":{"const":"aguayluz.infrastructure-ontology-deprecation/v0.1"},
    "deprecation_id":{"type":"string","minLength":1},
    "deprecated_identifier":{"type":"string","minLength":1},
    "replacement_identifiers":{"type":"array","uniqueItems":true,"items":{"type":"string"}},
    "effective_version":{"type":"string","minLength":1},
    "reason":{"type":"string","minLength":1},
    "queryable":{"const":true},
    "raw_records_rewritten":{"const":false},
    "provenance":{"type":"array","minItems":1,"items":{"type":"object"}}
  }
}