{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jotaele44/aguayluz-pr/schemas/infrastructure_measurement.schema.json",
  "title": "InfrastructureMeasurement",
  "type": "object",
  "additionalProperties": false,
  "required": ["measurement_id", "object_id", "measurement_type", "value", "unit", "source_assertion_ids", "identity_effect", "certification_state"],
  "properties": {
    "measurement_id": {"type": "string", "pattern": "^AYL_MEAS_[A-Z0-9_]+$"},
    "object_id": {"type": "string", "minLength": 1},
    "measurement_type": {"enum": ["design_flow", "firm_pumping_capacity", "wet_well_volume", "storage_capacity", "well_yield", "generator_capacity", "diameter", "elevation", "length", "other"]},
    "value": {"type": "number"},
    "unit": {"type": "string", "minLength": 1},
    "measurement_basis": {"type": ["string", "null"]},
    "effective_at": {"type": ["string", "null"], "format": "date-time"},
    "source_assertion_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "identity_effect": {"const": "none"},
    "certification_state": {"enum": ["PASS", "FAIL", "OPEN", "BLOCKED", "PROVISIONAL", "AUDIT_ONLY", "NONCANONICAL", "CANDIDATE_NOT_IDENTITY", "UNRESOLVED", "SUPERSEDED"]},
    "notes": {"type": ["string", "null"]}
  }
}
