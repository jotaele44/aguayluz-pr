{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jotaele44/aguayluz-pr/schemas/infrastructure_relation.schema.json",
  "title": "InfrastructureRelation",
  "description": "Evidence-backed typed relation between infrastructure objects; relation presence does not collapse object identities.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "relation_id",
    "from_object_id",
    "relation_type",
    "to_object_id",
    "evidence_refs",
    "identity_effect",
    "review_status"
  ],
  "properties": {
    "relation_id": {"type":"string","minLength":1},
    "from_object_id": {"type":"string","minLength":1},
    "relation_type": {
      "enum":[
        "located_at",
        "component_of",
        "feeds",
        "discharges_to",
        "pumps_to",
        "receives_from",
        "connected_to",
        "controlled_by",
        "monitored_by",
        "supplies",
        "serves_area",
        "historical_predecessor_of"
      ]
    },
    "to_object_id": {"type":"string","minLength":1},
    "evidence_refs": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},
    "identity_effect": {"const":"none"},
    "confidence": {"type":["integer","null"],"minimum":0,"maximum":100},
    "review_status": {"enum":["accepted","needs_review","blocked","rejected","fixture_only"]},
    "notes": {"type":["string","null"]}
  }
}
